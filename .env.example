# Copia este archivo como .env y ajusta los valores a tu PostgreSQL local
PORT=3000
DB_NAME=kloth
DB_USER=postgres
# Puede quedar vacio si tu PostgreSQL local no pide contrasena
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# NODE_ENV=production evita que se borren las tablas al arrancar
NODE_ENV=development
